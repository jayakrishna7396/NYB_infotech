App.jsx
import { useState } from "react";
import Child from "./Child";

function App() {
  const [message, setMessage] = useState("");

  function receiveMessage(data) {
    setMessage(data);
  }

  return (
    <div>
      <h1>Parent Component</h1>

      <p>Message from Child: {message}</p>

      <Child sendMessage={receiveMessage} />
    </div>
     );
}

export default App;